# Copy this file to .env and fill in the values. .env is git-ignored; never commit a real token.
# On Vercel, add the same variables under Project Settings â†’ Environment Variables.

# Hugging Face access token for the AI features (fine-grained, with "Make calls to Inference Providers").
# Create one at https://huggingface.co/settings/tokens
# Don't rename it to VITE_HF_TOKEN: VITE_ variables are bundled into the site and visible to everyone.
HF_TOKEN=

# Optional: the chat model to use, from https://huggingface.co/models?inference_provider=all
# HF_MODEL=openai/gpt-oss-120b
